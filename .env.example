# === Telegram user API ===
# Нужен для истории публичных каналов и доставки voice/video.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=repost.session

# === Бот-интерфейс (@BotFather) ===
BOT_TOKEN=
# твой chat id — узнать: напиши боту /id
OWNER_CHAT_ID=

# === LLM для перевода/обезличивания ===
# провайдер выбирается по наличию ключа (или задай LLM_PROVIDER=openai|anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# === Buffer (publish.buffer.com/settings/api) ===
BUFFER_ACCESS_TOKEN=
# каналы в формате platform:channelId через запятую; id смотри: python -m repost.publisher --channels
BUFFER_CHANNELS=linkedin:CHANNEL_ID,twitter:CHANNEL_ID,threads:CHANNEL_ID
# shareNow — публиковать сразу по кнопке | addToQueue — в очередь Buffer
BUFFER_POST_MODE=shareNow

# === Пайплайн ===
MIN_POST_CHARS=1
MAX_POST_CHARS=1500
# Отдельный AI-план для Threads: один законченный story/value point на карточку.
THREAD_ITEM_CHARS=500
THREAD_MAX_ITEMS=10
# 1500 — добровольная редакторская цель. Hard limit для всех площадок вычисляется
# в коде: min(LinkedIn 3000, X Premium 25000, Threads 10×500) = 3000.
# true: X Basic/Premium/Premium+ публикует до 25 000 символов одним постом
X_PREMIUM=true
# Отбор запускается вручную; cron забирает по одному посту с FIFO-полки.
PUBLISH_TIMES=09:00,14:00,19:00
DAILY_POSTS=3
ITEMS_PER_SLOT=1
# Однократный сбор выполняется вручную; AUTO_SYNC оставь false.
SYNC_TIME=08:00
SYNC_MONTHS=3
AUTO_SYNC=false
TIMEZONE=Europe/London
BOT_SEND_DELAY=1.1
BOT_MEDIA_MAX_BYTES=49000000
MEDIA_STAGE_TIMEOUT=90
DB_PATH=repost.db

# Факты о тебе — генератор использует их при обезличивании (что подставлять вместо чужих названий)
AUTHOR_FACTS=Name: Mike Doroshenko | Gender: man | Lives in London | Company: Vahue | Currently building SMM automation and projects that deploy AI agents for people and businesses | Previously worked at Meta in Applied AI | Vahue has more than 7 companies and 30 employees | Trained more than 50 people in AI

# === Vercel / PostgreSQL production ===
DATABASE_URL=
TELEGRAM_SESSION_STRING=
WEBHOOK_SECRET=
CRON_SECRET=
# Нужен также для стабильной публичной media-ссылки, которую Buffer забирает при публикации фото.
PUBLIC_BASE_URL=https://your-project.vercel.app
