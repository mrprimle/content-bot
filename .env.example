# === Telegram user API (my.telegram.org → API development tools) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=repost.session

# === Бот-интерфейс (@BotFather) ===
BOT_TOKEN=
# твой chat id — узнать: напиши боту /id
OWNER_CHAT_ID=

# === LLM для перевода/обезличивания ===
# провайдер выбирается по наличию ключа (или задай LLM_PROVIDER=openai|anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# === Buffer (publish.buffer.com/settings/api) ===
BUFFER_ACCESS_TOKEN=
# каналы в формате platform:channelId через запятую; id смотри: python -m repost.publisher --channels
BUFFER_CHANNELS=linkedin:CHANNEL_ID,twitter:CHANNEL_ID,threads:CHANNEL_ID
BUFFER_POST_MODE=addToQueue

# === Пайплайн ===
GENERATOR_MODE=translate            # translate — перевод с обезличиванием | rewrite — рерайт идеи
MIN_POST_CHARS=150
POST_TIMES=09:00,14:00,19:00
# месячный синк источников из sources.txt: день месяца, время, окно в днях
SYNC_DAY=1
SYNC_TIME=08:00
SYNC_DAYS=35
TIMEZONE=Europe/Kyiv
DB_PATH=repost.db

# Факты о тебе — генератор использует их при обезличивании (что подставлять вместо чужих названий)
AUTHOR_FACTS=Имя: ... | Компания: ... | Чем занимаюсь: ...
